@host = http://localhost:5264
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..A6V15z6fHvTFb8mntRZbGalklpnCJfqQctXHhea0VBw
@tenantToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..UvZdhN8vPglXPTq4EHizsZOgXAWTvyy0QNXjFzd3yp8
@tenantPortalId = 1
@unitId = 1
@tenantId = 1
@contractId = 1
@adminMaintId = 1
@offerMaintId = 2
@chargeId = 1
@mandatoryMaintId = 6
@mandatoryChargeId = 2
@rejectOfferMaintId = 10
@rejectChargeId = 3

# ═══════════════════════════════════════════════════════════════
# 🧪 ملف التجربة الشامل — نظام الصيانة والتحميل وتوجيه الدفعات
# ═══════════════════════════════════════════════════════════════
#
# 📌 طريقة الاستخدام (مهم جداً):
# 1) شغّل المشروع F5 وتأكد أن بورت المتصفح = 5264 (عدّل @host إن اختلف)
# 2) نفّذ طلب (0-دخول الإدارة) تحت ← انسخ token من الاستجابة
#    والصقه فوق مكان PASTE_ADMIN_TOKEN_HERE  ثم احفظ Ctrl+S
# 3) نفّذ طلب (0-دخول المستأجر) ← انسخ token في @tenantToken
#    وانسخ tenantId في @tenantPortalId ثم احفظ
# 4) نفّذ باقي الطلبات بالترتيب من الأعلى للأسفل
# 5) عند كل طلب "انسخ id" ← ضع الرقم في المتغير المذكور قبله واحفظ
#
# ⚠️ القيم الحالية مضبوطة على بياناتك الحقيقية:
#    contractId=1 (CTR-2026-0012) / tenantId=1 / unitId=1
#
# ⚠️ ملاحظة: إذا رجع طلب السداد برسالة (تم السداد مسبقاً) فهذا نجاح —
#    معناه الخصم التلقائي من رصيد المستأجر عمل عند القبول، تخطى الطلب.
# ═══════════════════════════════════════════════════════════════

### 0-دخول الإدارة (انقل التوكن لـ adminToken فوق واحفظ)
POST {{host}}/api/Auth/login
Content-Type: application/json

{
  "userName": "frames",
  "password": "528888"
}

### 0-دخول المستأجر (انقل token لـ tenantToken و tenantId لـ tenantPortalId فوق واحفظ)
POST {{host}}/api/Auth/tenant-login
Content-Type: application/json

{
  "userName": "TENANT_USER_NAME",
  "password": "TENANT_PASSWORD"
}

### 0-فحص سريع: لوحة المؤشرات (إثبات أن التوكن يعمل)
GET {{host}}/api/Reports/dashboard
Authorization: Bearer {{adminToken}}

### 🅰️ 1-إنشاء صيانة على الإدارة (بدون مستأجر — انسخ id من الاستجابة في adminMaintId فوق)
POST {{host}}/api/Maintenance
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "unitId": {{unitId}},
  "type": 1,
  "priority": 3,
  "description": "تجربة: صيانة كهرباء على الإدارة",
  "cost": 1000
}

### 🅰️ 2-إكمال الصيانة الإدارية ← تكلفة 1000 تصبح مصروفاً تلقائياً
PUT {{host}}/api/Maintenance/{{adminMaintId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": 3,
  "cost": 1000
}

### 🅰️ 3-تحقق: ابحث عن وصف (تكلفة تنفيذ صيانة) بمبلغ 1000
GET {{host}}/api/Reports/expenses
Authorization: Bearer {{adminToken}}

### 🅱️ 1-إنشاء صيانة العرض (انسخ id في offerMaintId فوق)
POST {{host}}/api/Maintenance
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "unitId": {{unitId}},
  "tenantId": {{tenantId}},
  "type": 4,
  "priority": 2,
  "description": "تجربة: استبدال زجاج واجهة المحل",
  "cost": 1000
}

### 🅱️ 2-الإكمال + عرض 1500 على المستأجر (لا مصروف ولا مديونية الآن + إشعار فوري له)
PUT {{host}}/api/Maintenance/{{offerMaintId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": 3,
  "cost": 1000,
  "billedToTenant": true,
  "billedAmount": 1500,
  "billingType": 2,
  "notes": "عرض صيانة الزجاج"
}

### 🅱️ 3-قائمة العروض المعلقة ← انسخ id التحميل في chargeId فوق واحفظ
GET {{host}}/api/Maintenance/charges?status=1
Authorization: Bearer {{adminToken}}

### 🅱️ 4-المستأجر يرى العروض المعلقة (يجب أن يظهر عرض الـ 1500)
GET {{host}}/api/TenantPortal/maintenance/{{tenantPortalId}}/charges/pending
Authorization: Bearer {{tenantToken}}

### 🅱️ 5-المستأجر يقبل العرض ← مصروف 1000 + مديونية 1500 في كشفه
POST {{host}}/api/TenantPortal/maintenance/{{tenantPortalId}}/charges/{{chargeId}}/accept
Authorization: Bearer {{tenantToken}}

### 🅱️ 6-تحقق: ظهرت المديونية في كشف حساب المستأجر
GET {{host}}/api/TenantPortal/statement/{{tenantPortalId}}
Authorization: Bearer {{tenantToken}}

### 🅱️ 7-سداد جزئي 500 من الـ 1500 (إذا رجع مسبقاً المسدد = نجاح، تخطاه)
POST {{host}}/api/Maintenance/charges/{{chargeId}}/settle
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "paymentMethod": 1,
  "amount": 500
}

### 🅱️ 8-إكمال سداد المتبقي (بدون amount = كامل المتبقي)
POST {{host}}/api/Maintenance/charges/{{chargeId}}/settle
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "paymentMethod": 2,
  "referenceNumber": "TRF-8899"
}

### 🅱️ 9-تحقق نهائي: التحميل حالة 4 مسدد
GET {{host}}/api/Maintenance/charges
Authorization: Bearer {{adminToken}}

### 🅲 1-إنشاء صيانة الإجبارية (انسخ id في mandatoryMaintId فوق)
POST {{host}}/api/Maintenance
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "unitId": {{unitId}},
  "tenantId": {{tenantId}},
  "type": 2,
  "priority": 4,
  "description": "تجربة: إصلاح سباكة طارئ (إجباري)",
  "cost": 300
}

### 🅲 2-إكمال + تحميل إجباري 300 ← فوراً: مصروف + مديونية + إشعار
PUT {{host}}/api/Maintenance/{{mandatoryMaintId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": 3,
  "cost": 300,
  "billedToTenant": true,
  "billedAmount": 300,
  "billingType": 3
}

### 🅲 3-قائمة غير المسدد ← انسخ id التحميل الإجباري في mandatoryChargeId فوق واحفظ
GET {{host}}/api/Maintenance/charges?unsettledOnly=true
Authorization: Bearer {{adminToken}}

### 🅲 4-إنشاء عرض ثانٍ لتجربة الرفض (انسخ id في rejectOfferMaintId فوق)
POST {{host}}/api/Maintenance
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "unitId": {{unitId}},
  "tenantId": {{tenantId}},
  "type": 5,
  "priority": 1,
  "description": "تجربة: صيانة عرض ثانٍ (سيتم رفضه)",
  "cost": 200
}

### 🅲 5-الإكمال + عرض 400
PUT {{host}}/api/Maintenance/{{rejectOfferMaintId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": 3,
  "cost": 200,
  "billedToTenant": true,
  "billedAmount": 400,
  "billingType": 2
}

### 🅲 6-قائمة المعلقة ← انسخ id العرض الجديد (400) في rejectChargeId فوق واحفظ
GET {{host}}/api/Maintenance/charges?status=1
Authorization: Bearer {{adminToken}}

### 🅲 7-المستأجر يرفض العرض ← لا مصروف ولا مديونية + إشعار للإدارة بالسبب
POST {{host}}/api/TenantPortal/maintenance/{{tenantPortalId}}/charges/{{rejectChargeId}}/reject
Authorization: Bearer {{tenantToken}}
Content-Type: application/json

{
  "reason": "التكلفة أعلى من المتوقع — سأعيّن ورشة خاصة"
}

### 💰 1-دفعة عادية (كالوضع القديم — بدون allocationMode)
POST {{host}}/api/Payments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "contractId": {{contractId}},
  "paymentType": 1,
  "amount": 250,
  "paymentMethod": 1,
  "notes": "دفعة عادية عادية"
}

### 💰 2-تسوية الدفعة بالتحميل الإجباري ← 500 تسدد 300 والفائض 200 يروح محفظته
POST {{host}}/api/Payments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "contractId": {{contractId}},
  "paymentType": 6,
  "amount": 500,
  "paymentMethod": 1,
  "allocationMode": 2,
  "chargeId": {{mandatoryChargeId}},
  "notes": "سداد التحميل + فائض للمحفظة"
}

### 💰 3-تحقق: الرصيد زاد 200
GET {{host}}/api/TenantAccounts/{{tenantId}}/statement
Authorization: Bearer {{adminToken}}

### 💰 4-دفعة على الحساب ← 4000 كاملة رصيد (تُخصم آلياً شهرياً)
POST {{host}}/api/Payments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "contractId": {{contractId}},
  "paymentType": 1,
  "amount": 4000,
  "paymentMethod": 2,
  "allocationMode": 3,
  "referenceNumber": "TRF-PREPAID-001",
  "notes": "دفعة مسبقة تغطي عدة أشهر"
}

### 💰 5-تحقق: الرصيد زاد 4000
GET {{host}}/api/TenantAccounts/{{tenantId}}/statement
Authorization: Bearer {{adminToken}}

### 📊 1-ملخص الإيرادات المنفصلة (إيجار / صيانة محمّلة + صافي الربح)
GET {{host}}/api/Reports/income-summary
Authorization: Bearer {{adminToken}}

### 📊 2-الأداء السنوي الشهري (rentRevenue و otherRevenue منفصلين)
GET {{host}}/api/Reports/financial-performance/2026
Authorization: Bearer {{adminToken}}
